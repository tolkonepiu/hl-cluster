{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "docker:enableMajor",
    "github>tolkonepiu/hl-cluster//.renovate/customManagers.json5",
    "github>tolkonepiu/hl-cluster//.renovate/grafanaDashboards.json5",
    "github>tolkonepiu/hl-cluster//.renovate/groups.json5",
    "github>tolkonepiu/hl-cluster//.renovate/labels.json5",
    "github>tolkonepiu/hl-cluster//.renovate/semanticCommits.json5",
    "github>tolkonepiu/hl-cluster//.renovate/customVersioning.json5",
    "github>tolkonepiu/hl-cluster//.renovate/versionExclusions.json5",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  ignorePaths: ["**/*.sops.*"],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  helmfile: {
    managerFilePatterns: ["/(^|/)bootstrap/helmfile\\.d/.+\\.ya?ml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kustomization\\.ya?ml$/"],
  },
}
